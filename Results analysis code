# Generate all pairwise combinations

```{r Shannon family level }

# Load required libraries
library(dplyr)
library(ggplot2)
library(vegan)  

# Read in your data
data_RPM <- read.csv("Standardised_reads.csv", header = TRUE)

# Step 1: Identify viral family columns
viral_cols <- which(names(data_RPM) %in% c("Aliusviridae", "Chuviridae", "Dicistroviridae", 
                                             "Ghabrivirales", "Hareavirales", "Metaviridae",
                                             "Nodaviridae", "Orthomyxoviridae", "Orthototoviridae", 
                                             "Partitiviridae", "Parvoviridae", "Peribunyaviridae", 
                                             "Phasmaviridae", "Picornaviridae", "Quinviridae", "Reovirales", "Rhabdoviridae", "Sedoreoviridae",  "Spiciviridae","Tombusviridae", "Virgaviridae", "Xinmoviridae"))

# Step 2: Calculate Shannon index per sample
# vegan::diversity requires non-negative abundance values
data_RPM$shannon <- diversity(data_RPM[, viral_cols], index = "shannon")

# Step 3: Summarize Shannon index by Bird_order
order_summary <- data_RPM %>%
  group_by(Land_use) %>%
  summarise(mean_shannon = mean(shannon),
            sd_shannon = sd(shannon),
            n = n(),
            se_shannon = sd_shannon / sqrt(n))

# View summary table
print(order_summary)

# Step 4: Plot Shannon index per Bird_order
ggplot(data_RPM, aes(x = Land_use, y = shannon)) +
  geom_boxplot(fill = "skyblue", color = "black") +
  geom_jitter(width = 0.2, height = 0, alpha = 0.5) +
  labs(title = "Shannon Diversity Index per Bird Order",
       y = "Shannon Diversity (H')",
       x = "Bird Order") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))

# Step 5: Kruskal-Wallis test for Shannon index
kruskal.test(shannon ~ Land_use, data = data_RPM)
#Kruskal-Wallis chi-squared = 5.1472, df = 3, p-value = 0.1613

```

