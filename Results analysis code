```{r phylum richness graph }

library(dplyr)
library(ggplot2)

meta <- read.csv("metadata_csv.csv")

# Calculate mean and standard error/deviation per land use
summary_stats <- meta %>%
  group_by(land_use) %>%
  summarise(
    mean_phyla = mean(n_phyla, na.rm = TRUE),
    sd_phyla = sd(n_phyla, na.rm = TRUE),
    n = n()
  )

# Custom colors matching the image
land_use_colors <- c("Beach" = "#1B8A9F",
                      "Grassland" = "#B29DC9",
                      "Tall Forest" = "#8FAE5D",
                      "Wetland" = "#E3197D")

ggplot() +
  geom_col(data = summary_stats,
           aes(x = land_use, y = mean_phyla, fill = land_use),
           width = 0.7, color = NA) +
  geom_errorbar(data = summary_stats,
                aes(x = land_use, ymin = mean_phyla - sd_phyla, ymax = mean_phyla + sd_phyla),
                width = 0.2, linewidth = 0.6) +
  geom_jitter(data = meta,
              aes(x = land_use, y = n_phyla),
              width = 0.1, size = 2, color = "grey30", alpha = 0.8) +
  scale_fill_manual(values = land_use_colors) +
  theme_minimal(base_size = 13) +
  theme(
    panel.grid.major.x = element_blank(),
    panel.grid.minor = element_blank(),
    axis.title = element_text(face = "bold"),
    legend.title = element_text(face = "bold")
  ) +
  labs(x = "Land Use", y = "Mean Number of Phyla", fill = "Land Use")

```



