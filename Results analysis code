```{r viral families by land use }
library(dplyr)
library(tidyr)
library(ggplot2)

norm_reads <- read.csv("Standardised_reads.csv")

norm_long <- norm_reads %>%
  pivot_longer(cols = -c(Pool_ID, Land_use), names_to = "family", values_to = "abundance")

family_summary <- norm_long %>%
  group_by(Land_use, family) %>%
  summarise(total_abundance = sum(abundance, na.rm = TRUE), .groups = "drop") %>%
  group_by(Land_use) %>%
  mutate(proportion = total_abundance / sum(total_abundance)) %>%
  ungroup()

ggplot(family_summary, aes(x = Land_use, y = proportion, fill = family)) +
  geom_bar(stat = "identity", position = "fill", color = "white", linewidth = 0.2) +
  theme_minimal() +
  labs(x = "Land Use", y = "Relative Abundance", fill = "Viral Family",
       title = "Viral Family Composition by Land Use") +
  theme(axis.text.x = element_text(angle = 0))

```


